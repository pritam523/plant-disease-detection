# Copy this file to .env and edit locally. Never commit .env.
# All keys and passwords stay on the server side.

# ---- Local server ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- Local project files ----
# Leave these empty to use the defaults shown in README.md.
MODEL_PATH=
CLASS_NAMES_PATH=
DISEASES_PATH=
DATA_DIR=

# ---- Classifier behaviour ----
PREDICTION_CONFIDENCE_THRESHOLD=0.50
PREDICTION_MARGIN_THRESHOLD=0.10
TTA_ENABLED=true
TTA_VIEWS=4
IMAGE_GUARD_ENABLED=true

# ---- Visual analysis support (backend only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDING_ENABLED=false
GEMINI_TIMEOUT=20

# ---- Optional external references ----
AI_FALLBACK_ENABLED=true
OPEN_METEO_ENABLED=true
PLANTNET_API_KEY=
PLANTNET_ENABLED=false

# ---- Admin panel ----
# Generate a hash with: python run.py hash-password
ADMIN_PASSWORD_HASH=
# Replace with a long random string before sharing the app.
ADMIN_SECRET_KEY=change-this-to-a-long-random-string-before-use
ADMIN_SESSION_MAX_AGE=28800
